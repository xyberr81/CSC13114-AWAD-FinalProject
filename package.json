{
  "name": "leetkob",
  "version": "0.1.0",
  "private": true,
  "description": "LeeTKOB — constraint review for Accepted C++ lab submissions (CSC13114 class project)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @leetkob/api",
    "build": "npm run build --workspaces --if-present",
    "start": "npm start -w @leetkob/api",
    "create-admin": "npm run create-admin -w @leetkob/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:contract": "npm run test:contract -w @leetkob/api",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:contract",
    "db:generate": "npm run db:generate -w @leetkob/api",
    "db:migrate": "npm run db:migrate -w @leetkob/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2"
  }
}
