# Every variable the app and its tests read, without values. Copy to .env (git-ignored) and fill in.

# Server
PORT=
HOST=
LOG_LEVEL=

# Database (docker-compose.yml reads the POSTGRES_* values)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Auth
JWT_SECRET=

# Model provider: OpenRouter. The key has a $2 credit limit set on it (README §Model and cost).
# Not read by the app until PA#3. Never passed to the judge worker or the sandbox.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Contract tests only (optional): run them against a deployed server instead of in-process.
CONTRACT_BASE_URL=
