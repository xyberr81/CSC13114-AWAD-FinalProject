# Every variable the app reads, without values. Copy to .env (git-ignored) and fill in.

# Server
PORT=
HOST=
LOG_LEVEL=

# Database (docker-compose.yml reads the POSTGRES_* values)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Auth
JWT_SECRET=

# Model provider (PA#3) — the key has a spending cap set in the provider console.
# Never passed to the judge worker or the sandbox.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
