# Every variable the app and its tests read, without values. Copy to .env (git-ignored) and fill in.

# Server
PORT=
HOST=
LOG_LEVEL=

# Database (docker-compose.yml reads the POSTGRES_* values)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Auth
JWT_SECRET=

# First admin: `npm run create-admin` (or `node dist/create-admin.js`) reads these and makes the
# account if it does not exist yet. Needed only for that command, not by the server. Password: 8-200 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Model provider: the Claude Platform (README §Model and cost).
# LLM_PROVIDER is anthropic; LLM_MODEL is a model name (README, Model and cost), not a key; LLM_API_KEY
# is a Claude Console API key. Read by the review worker and the checker. Never passed to the judge worker or the sandbox.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Contract tests only (optional): run them against a deployed server instead of in-process.
CONTRACT_BASE_URL=

# Worker (npm run worker). A worker that only judges must not be given LLM_API_KEY.
WORKER_JOBS=
WORKER_CONCURRENCY=
# 1: hard rules only, no model call
MODEL_OFF=
