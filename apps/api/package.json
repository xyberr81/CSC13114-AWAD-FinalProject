{
  "name": "@leetkob/api",
  "version": "0.1.0",
  "private": true,
  "description": "LeeTKOB API: Fastify, Drizzle, PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "web-tree-sitter": "^0.27.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vitest": "^5.1.0"
  }
}
